# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# Database: sqlite | postgres
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=
DB_DATABASE=carPro

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
FRONTEND_URL=http://localhost:3000

# Session
SESSION_DRIVER=cookie

# Owner mandate terms version
TERMS_VERSION=v1

# Mail — Hostinger SMTP
MAIL_MAILER=smtp
MAIL_FROM_NAME="Profil Car Service"
MAIL_FROM_ADDRESS=noreply@your-domain.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USERNAME=noreply@your-domain.com
SMTP_PASSWORD=
SMTP_SECURE=false

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

MARKETPLACE_SYNC_SECRET=
WEB_CLIENT_URL=http://localhost:3001
